# PokeSix — Qt 스타일 기반 (qtbase의 _clang-format을 단순화한 것)
# clang-format 15+ 기준
---
Language: Cpp
BasedOnStyle: WebKit
Standard: c++20

ColumnLimit: 100
IndentWidth: 4
ContinuationIndentWidth: 8
UseTab: Never
AccessModifierOffset: -4
NamespaceIndentation: None
FixNamespaceComments: true
InsertNewlineAtEOF: true

# Qt 관례: `QWidget *parent`
PointerAlignment: Right
ReferenceAlignment: Right

# 중괄호: 클래스/함수 정의만 새 줄, 제어문은 같은 줄
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: true
  AfterFunction: true
  AfterStruct: true
  AfterUnion: true
  AfterEnum: false
  AfterNamespace: false
  AfterControlStatement: Never
  BeforeElse: false
  BeforeCatch: false
  BeforeLambdaBody: false
  SplitEmptyFunction: false
  SplitEmptyRecord: false

AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortLambdasOnASingleLine: Inline
AlwaysBreakTemplateDeclarations: Yes

# 생성자 초기화 리스트: Qt 스타일(콤마 앞에서 줄바꿈)
#   Foo::Foo(QObject *parent)
#       : QObject(parent)
#       , m_value(0)
BreakConstructorInitializers: BeforeComma
BreakBeforeBinaryOperators: All
AlignAfterOpenBracket: Align
AlignOperands: Align
AlignEscapedNewlines: DontAlign
AlignTrailingComments: true
Cpp11BracedListStyle: true
SpaceAfterTemplateKeyword: false

# include 정렬: 대응 헤더 → 프로젝트 → Qt → 테스트 → 표준/기타
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^"'
    Priority: 1
  - Regex: '^<Q'
    Priority: 2
  - Regex: '^<(gtest|gmock)/'
    Priority: 3
  - Regex: '^<'
    Priority: 4

# Qt 매크로를 함수 호출이 아닌 구문으로 인식시킨다
ForEachMacros: [forever, Q_FOREACH]
StatementAttributeLikeMacros: [emit]
