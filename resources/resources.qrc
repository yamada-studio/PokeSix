<!DOCTYPE RCC>
<!--
  Qt resources, compiled into the PokeSix executable (qt_add_big_resources in src/CMakeLists.txt)
  and read at runtime through virtual paths such as ":/styles/app.qss".
  Paths are relative to this file. Only original or license-checked assets (fonts: OFL).
-->
<RCC version="1.0">
  <qresource prefix="/">
    <file>styles/app.qss</file>
    <file>theme/dexstyle.json</file>
    <file>theme/itemstyle.json</file>
    <file>theme/homecards.json</file> <!-- 홈 세대 카드: 마스코트 · 색 · 지방 -->
    <file>data/townmap/johto.json</file>
    <file>data/townmap/kanto.json</file>
    <file>data/townmap/johto-kanto.json</file>
    <file>data/townmap/sinnoh.json</file>
    <file>data/townmap/unova.json</file>
    <file>data/townmap/landmarks/heartgold-soulsilver.json</file> <!-- 타운맵 노드(장소 → 지도 픽셀 영역) · 이미지는 실행 시 다운로드 -->
    <file>data/acquisition/platinum.json</file> <!-- 게임별 입수 사전(기술머신 · 도구 · NPC 가르침) -->
    <file>data/acquisition/emerald.json</file>
    <file>data/acquisition/heartgold-soulsilver.json</file>
    <file>data/acquisition/black-2-white-2.json</file>
    <file>data/acquisition/black-white.json</file>
    <file>data/acquisition/blue-japan.json</file>
    <file>data/acquisition/brilliant-diamond-shining-pearl.json</file>
    <file>data/acquisition/champions.json</file>
    <file>data/acquisition/crystal.json</file>
    <file>data/acquisition/diamond-pearl.json</file>
    <file>data/acquisition/firered-leafgreen.json</file>
    <file>data/acquisition/gold-silver.json</file>
    <file>data/acquisition/legends-arceus.json</file>
    <file>data/acquisition/legends-za.json</file>
    <file>data/acquisition/lets-go-pikachu-lets-go-eevee.json</file>
    <file>data/acquisition/mega-dimension.json</file>
    <file>data/acquisition/omega-ruby-alpha-sapphire.json</file>
    <file>data/acquisition/red-blue.json</file>
    <file>data/acquisition/red-green-japan.json</file>
    <file>data/acquisition/ruby-sapphire.json</file>
    <file>data/acquisition/scarlet-violet.json</file>
    <file>data/acquisition/sun-moon.json</file>
    <file>data/acquisition/sword-shield.json</file>
    <file>data/acquisition/the-crown-tundra.json</file>
    <file>data/acquisition/the-indigo-disk.json</file>
    <file>data/acquisition/the-isle-of-armor.json</file>
    <file>data/acquisition/the-teal-mask.json</file>
    <file>data/acquisition/ultra-sun-ultra-moon.json</file>
    <file>data/acquisition/x-y.json</file>
    <file>data/acquisition/yellow.json</file>
    <file>data/place-names.json</file>       <!-- 장소 한국어 이름 사전 -->
    <file>data/names.json</file>             <!-- 이름 · 설명 보충 사전 (PokéAPI에 없는 한국어) -->
    <file>data/encounter-methods.json</file> <!-- 야생 출현 방법 이름 -->
    <file>data/starters.json</file>          <!-- 게임별 스타팅 포켓몬 -->
    <file>data/move-effects.json</file>      <!-- 변화 기술 설명의 세대 차이 · 예외 -->
    <file>icons/cursor/glove-point.svg</file> <!-- 흰 장갑 커서(가리키기) -->
    <file>icons/cursor/glove-grab.svg</file>  <!-- 흰 장갑 커서(움켜쥐기) -->
    <file>icons/ui/check-white.svg</file> <!-- QCheckBox 체크 표시 (app.qss) -->

    <file>fonts/DoHyeon-Regular.ttf</file>
    <file>fonts/NanumGothic-Regular.ttf</file>
    <file>fonts/NanumGothic-Bold.ttf</file>
    <file>fonts/NanumGothic-ExtraBold.ttf</file>
    <file>fonts/NanumGothicCoding-Regular.ttf</file>
    <file>fonts/NanumGothicCoding-Bold.ttf</file>
    <file>fonts/Silkscreen-Regular.ttf</file>
    <file>fonts/Silkscreen-Bold.ttf</file>

    <file alias="icons/mark/pokesix-mark.svg">icons/app/svg/pokesix-mark.svg</file>
    <file alias="icons/mark/pokesix-mark-on-red.svg">icons/app/svg/pokesix-mark-on-red.svg</file>
    <file alias="icons/mark/pokesix-mark-small.svg">icons/app/svg/pokesix-mark-small.svg</file>

    <!-- Window icon sizes. 16px is the hand-drawn pixel version (design 01b §6-3). -->
    <file alias="icons/window/pokesix-16.png">icons/app/windows/pokesix-16-pixel.png</file>
    <file alias="icons/window/pokesix-32.png">icons/app/linux/hicolor/32x32/apps/pokesix.png</file>
    <file alias="icons/window/pokesix-64.png">icons/app/linux/hicolor/64x64/apps/pokesix.png</file>
    <file alias="icons/window/pokesix-128.png">icons/app/linux/hicolor/128x128/apps/pokesix.png</file>
    <file alias="icons/window/pokesix-256.png">icons/app/linux/hicolor/256x256/apps/pokesix.png</file>
  </qresource>
</RCC>
