/* PokeSix 앱 전역 스타일시트 (라이트 테마). QSS = Qt Style Sheets, CSS와 비슷한 문법.
   출발점은 design/handoff-v2/design/pokesix.qss. 색은 "@이름" 자리표시로 쓰고, 실행 시
   theme::apply()가 src/ui/theme/tokens.h의 값으로 바꾼다(예: @red.deep → #B8241D).
   창 그림자 · 타입 칩 · 히트맵 · 종족값 바 · 앱 막대 탭처럼 QSS로 안 되는 것은 paintEvent에서 그린다.
   글꼴 이름은 등록된 실제 이름을 쓴다: "NanumGothic"(핸드오프의 "Nanum Gothic" 아님), "NanumGothicCoding". */


/* 종이색 바탕은 창에만 준다. QWidget 전체에 주면 "평범한 QWidget"(레이아웃을 담는 상자 등)이
   전부 종이색을 칠해서, 흰 패널이나 사선 무늬 위에 사각형이 생긴다. 직접 그리는 위젯은 원래 QSS 배경을 칠하지 않는다. */
QMainWindow { background: @paper; }

QWidget {
  color: @text.1;
  font-family: "NanumGothic";
  font-size: 13px;
}

QToolTip {
  background: @white; color: @text.1;
  border: 2px solid @ink; border-radius: 6px; padding: 6px 8px;
}

/* ── 버튼: setProperty("variant", "primary" | "secondary" | "text" | "danger") ── */
QPushButton {
  font-family: "Do Hyeon"; font-size: 16px;
  min-height: 32px; padding: 0 14px;
  border: 2px solid @ink; border-radius: 6px;
  background: @white; color: @text.1;
}
QPushButton[variant="primary"] { background: @red; color: @white; }
QPushButton[variant="primary"]:pressed { background: @red.deep; }
QPushButton[variant="info"] { background: @blue; color: @white; }
QPushButton[variant="text"] { border-color: transparent; background: transparent; color: @blue; }
QPushButton[variant="danger"] { border-color: @red; color: @red.deep; }
QPushButton:hover { background: @paper; }
QPushButton[variant="primary"]:hover { background: #E0443C; }
QPushButton:focus { outline: none; border-color: @blue; }
QPushButton:disabled { border: 2px dashed @line.strong; color: @text.disabled; background: transparent; }
/* 아래 3px 단단한 그림자는 ShadowButton(QPushButton 서브클래스) paintEvent에서 추가 */

/* ── 입력 ── */
QLineEdit {
  min-height: 32px; padding: 0 10px;
  border: 2px solid @ink; border-radius: 6px;
  background: @white; color: @text.1;
  font-family: "Do Hyeon"; font-size: 15px; /* 입력 글자도 앱 글꼴로 — 나눔고딕 13은 기본 글꼴처럼 보인다 */
  selection-background-color: @yellow; selection-color: @text.1;
}
QLineEdit:focus { border-color: @blue; }
/* 역할 메모는 문장이라 본문 글꼴 유지 */
QLineEdit[role="memo"] { min-height: 24px; border: 1.5px solid @line.strong; border-radius: 5px; background: @paper.alt; color: @text.2; font-family: "NanumGothic"; font-size: 12px; }

QCheckBox { spacing: 8px; font-weight: 700; }
QCheckBox::indicator { width: 16px; height: 16px; border: 2px solid @ink; border-radius: 3px; background: @white; }
QCheckBox::indicator:checked { background: @red; image: url(:/icons/ui/check-white.svg); }

/* ── 표 ── */
QTableView {
  background: @white; alternate-background-color: @paper.alt;
  border: none; gridline-color: @line.soft;
  selection-background-color: @yellow.tint; selection-color: @text.1;
}
QHeaderView::section {
  background: @white; color: @text.2;
  font-size: 11px; font-weight: 800;
  border: none; border-bottom: 2px solid @ink; padding: 0 6px; min-height: 28px;
}

/* ── 스크롤바: 두꺼운 먹선 손잡이 ── */
QScrollBar:vertical { width: 14px; background: @paper.alt; border-left: 1px solid @line; }
QScrollBar::handle:vertical { min-height: 32px; margin: 2px; border: 2px solid @ink; border-radius: 4px; background: @white; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar:horizontal { height: 14px; background: @paper.alt; border-top: 1px solid @line; }
QScrollBar::handle:horizontal { min-width: 32px; margin: 2px; border: 2px solid @ink; border-radius: 4px; background: @white; }

/* ── 메뉴 (세대 전환 등) ── */
QMenu { background: @white; border: 2px solid @ink; border-radius: 6px; padding: 4px; }
QMenu::item { padding: 8px 14px 8px 26px; border-radius: 4px; font-family: "Do Hyeon"; font-size: 16px; }
QMenu::item:selected { background: @yellow.tint; }

/* ── 라벨은 전역 배경(paper)을 칠하지 않는다. 무늬 · 패널 위에 얹히기 때문 ── */
QLabel { background: transparent; }

/* ── 인트로(HomePage) — 위젯은 objectName으로 고른다: QLabel#이름 ── */
QLabel#introSubtitle { font-family: "Do Hyeon"; font-size: 22px; color: @text.2; }
QLabel#introGenerationLabel { font-size: 12px; font-weight: 700; color: @text.3; }
QLabel#introVersion { font-family: "NanumGothicCoding"; font-size: 12px; font-weight: 700; color: @text.2; }
QLabel#introKeyCap {
  font-family: "NanumGothicCoding"; font-size: 12px; font-weight: 700; color: @text.2;
  padding: 1px 5px; border: 1px solid @line.strong; border-radius: 3px; background: @white;
}
QLabel#introKeyHint { font-size: 12px; font-weight: 700; color: @text.2; }
QLabel#introSource { font-size: 12px; color: @text.2; }

/* ── 첫 실행 패널(FirstRunPanel) ── */
QStackedWidget#firstRunPages { background: transparent; }
QLabel#firstRunTitle { font-family: "Do Hyeon"; font-size: 20px; color: @text.1; }
QLabel#firstRunFailedTitle { font-family: "Do Hyeon"; font-size: 20px; color: @red.text; }
QLabel#firstRunBody { font-size: 12px; color: @text.2; }
QLabel#firstRunMeta { font-family: "NanumGothicCoding"; font-size: 11px; color: @text.3; }
QLabel#firstRunStep { font-size: 12px; font-weight: 700; color: @text.1; }
QLabel#firstRunPercent { font-family: "NanumGothicCoding"; font-size: 12px; font-weight: 700; color: @text.1; }
QLabel#firstRunNote { font-size: 12px; color: @text.3; }

/* ── 앱 막대 검색 칸(SearchField): 테두리 · 바탕은 바깥 상자가 그린다 ── */
QLineEdit#searchFieldInput {
  min-height: 0; padding: 0; border: none; background: transparent;
  font-size: 14px; color: @text.1; /* 글꼴은 QLineEdit 규칙(도현)을 따른다 */
}
QLabel#searchFieldShortcut {
  font-family: "NanumGothicCoding"; font-size: 11px; color: @text.3;
  padding: 1px 5px; border: 1px solid @line.strong; border-radius: 3px;
}

/* ── 아직 만들지 않은 페이지의 자리 표시 ── */
QLabel#filterCaption { font-size: 12px; font-weight: 700; color: @text.3; }
QLabel#filterValue { font-family: "NanumGothicCoding"; font-size: 12px; font-weight: 700; color: @text.2; }
QLabel#itemEffect { font-size: 13px; color: @text.2; }
QLabel#previewEmpty { font-size: 13px; color: @text.3; }
QLabel#pagePlaceholder { font-family: "Do Hyeon"; font-size: 28px; color: @text.3; }

/* ── 도감 목록 표 (DexPage). 칸은 DexRowDelegate가 그리고, 여기서는 표 바탕 · 머리만 ── */
QTableView#dexTable { border: none; background: @white; }

/* ── 아이템 대백과 (ItemsPage). 칸은 ItemRowDelegate · 머리는 ItemHeaderView가 그린다 ── */
QTableView#itemsTable { border: none; background: @white; }

/* ── 도감 상세 (DexDetailPage). 섹션은 PanelFrame · 직접 그리는 위젯이 그린다 ── */
QScrollArea#dexDetailScroll, QScrollArea#dexDetailScroll > QWidget > QWidget#dexDetailContent { background: transparent; border: none; }
QScrollArea#itemDetailScroll, QScrollArea#itemDetailScroll > QWidget > QWidget#itemDetailContent { background: transparent; border: none; }
QScrollArea#dexDetailScroll > QWidget { background: transparent; }
QLabel#dexDetailBasis { font-size: 13px; font-weight: 700; color: @text.2; }
QScrollArea#dexEncounterScroll, QScrollArea#dexEncounterScroll > QWidget { background: transparent; border: none; }
QWidget#dexAcquisition { background: @white; }
QLabel#dexSectionLabel { font-family: "Do Hyeon"; font-size: 15px; color: @text.1; }

/* ── 스쿼드(SquadPage) ── */
QDialog { background: @paper; }
QScrollArea#squadScroll, QScrollArea#squadScroll > QWidget, QWidget#squadContent { background: transparent; border: none; }
QLineEdit#squadName {
  min-height: 36px; padding: 0 2px; border: none; border-bottom: 2px solid transparent; border-radius: 0;
  background: transparent; font-family: "Do Hyeon"; font-size: 28px; color: @text.1;
}
QLineEdit#squadName:hover { border-bottom-color: @line.strong; }
QLineEdit#squadName:focus { border-bottom-color: @blue; }
QLabel#squadRulePill {
  background: @yellow.soft; border: 2px solid @ink; border-radius: 12px; padding: 1px 10px;
  font-family: "Do Hyeon"; font-size: 15px; color: @text.1;
}
QLabel#squadCount { font-family: "NanumGothicCoding"; font-size: 13px; font-weight: 700; color: @text.2; }
QPushButton#squadShuttleButton {
  background: @paper.alt; border: 2px solid @ink; border-radius: 12px; padding: 1px 10px;
  font-family: "Do Hyeon"; font-size: 15px; color: @text.1;
}
QPushButton#squadShuttleButton:hover { background: @blue.tint; }
QPushButton#squadToolButton {
  background: @paper.alt; border: 2px solid @ink; border-radius: 12px; padding: 1px 10px;
  font-family: "Do Hyeon"; font-size: 15px; color: @text.1;
}
QPushButton#squadToolButton:hover { background: @blue.tint; }
QPushButton#squadToolButton::menu-indicator { image: none; width: 0; }
QToolButton#squadIconButton { background: transparent; border: none; border-radius: 6px; padding: 3px; }
QToolButton#squadIconButton:hover:enabled { background: @blue.tint; }
QToolButton#squadIconButton:pressed { background: @blue.cell; }
QPushButton#shuttlePickButton {
  background: @paper.alt; border: 2px solid @ink; border-radius: 12px; padding: 6px 16px;
  font-family: "Do Hyeon"; font-size: 20px; color: @text.1;
}
QPushButton#shuttlePickButton:hover { background: @blue.tint; }
QFrame#shuttleTable { background: @paper.alt; border: 2px solid @ink; border-radius: 12px; }
QLabel#shuttleStatus { font-size: 12px; font-weight: 700; color: @text.2; }
QLabel#shuttleStatus[state="ok"] { color: @green; }
QLabel#shuttleStatus[state="warn"] { color: @red.text; }
QLabel#shuttleStatus[state="none"] { color: @text.3; font-weight: 400; }
QLabel#squadSaveStatus { font-size: 13px; font-weight: 700; color: @green; }
QLabel#squadSaveStatus[state="pending"] { color: @text.3; }
QLabel#squadSaveStatus[state="error"] { color: @red; }
QLabel#squadProblemPill {
  background: @red; color: @white; border: 2px solid @white; border-radius: 12px; padding: 1px 10px;
  font-family: "Do Hyeon"; font-size: 15px;
}
QLabel#squadProblemPill[ok="true"] { background: @green; }
QLabel#squadNote { font-size: 11px; color: @text.3; }
QLabel#squadResources { font-size: 12px; color: @text.2; }
/* 분석 칸 제목 줄의 글자 링크("크게 보기 ↗") — 섹션 제목 높이(15px)에 맞춘 작은 버튼 */
QPushButton#squadLinkButton {
  background: transparent; border: none; padding: 0 2px; min-height: 0;
  font-size: 12px; font-weight: 700; color: @text.2; text-decoration: underline;
}
QPushButton#squadLinkButton:hover { color: @red; }
QLabel#squadEmpty { font-family: "Do Hyeon"; font-size: 20px; color: @text.3; }
QListView#squadPickerList { border: 2px solid @ink; border-radius: 6px; background: @white; outline: none; }
